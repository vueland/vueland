{
  "name": "@vueland/ui",
  "description": "Vue 3 component library for the Vueland platform",
  "version": "0.5.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Anar Allakhverdiev",
    "url": "https://github.com/wiseadme"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vueland/vueland.git",
    "directory": "packages/ui"
  },
  "homepage": "https://vueland.github.io/vueland/en/",
  "bugs": {
    "url": "https://github.com/vueland/vueland/issues"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vue3",
    "vue-component-library",
    "ui-library",
    "design-system",
    "vite",
    "typescript",
    "scss",
    "jit",
    "utility-css",
    "components",
    "composables",
    "frontend-platform"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.js",
      "require": "./dist/composables/index.js"
    },
    "./directives": {
      "types": "./dist/directives/index.d.ts",
      "import": "./dist/directives/index.js",
      "require": "./dist/directives/index.js"
    },
    "./resolvers": {
      "types": "./dist/resolvers/index.d.ts",
      "import": "./dist/resolvers/index.js",
      "require": "./dist/resolvers/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js",
      "require": "./dist/constants/index.js"
    },
    "./constants/*": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/*.js",
      "require": "./dist/constants/*.js"
    },
    "./enums/*": {
      "types": "./dist/enums/index.d.ts",
      "import": "./dist/enums/index.js",
      "require": "./dist/enums/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.d.ts"
    },
    "./css/lib.css": "./dist/css/lib.css",
    "./css/utils.css": "./dist/css/utils.css",
    "./styles.css": "./dist/styles.css",
    "./css/utils/*": "./dist/css/utils/*",
    "./styles/styles.scss": "./dist/styles/styles.scss",
    "./styles/lib.scss": "./dist/styles/lib.scss",
    "./styles/utils.scss": "./dist/styles/utils.scss",
    "./styles/tools.scss": "./dist/styles/tools.scss",
    "./styles/tools/state-layer": "./dist/styles/tools/_state-layer.scss",
    "./styles/tools/state-layer.scss": "./dist/styles/tools/_state-layer.scss"
  },
  "peerDependencies": {
    "vue": "^3.5.27"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:js && pnpm run build:dts && pnpm run gen:globals && node ./build/insert-ref.mjs && pnpm run types:clean && pnpm run build:scss",
    "build:js": "vite build --config ./build/vite.config.ts",
    "build:dts": "rollup -c ./build/rollup.dts.config.mjs",
    "build:scss": "node ./build/copy-scss.mjs",
    "build-lib": "pnpm run clean && pnpm run build:types && pnpm run build:js && pnpm run build:dts && pnpm run gen:globals && node ./build/insert-ref.mjs && pnpm run types:clean && pnpm run build:scss",
    "prepack": "pnpm run build-lib",
    "build:types": "vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "lint": "eslint src/**/*.vue",
    "lint:fix": "eslint src/**/*.vue --fix",
    "test:lib": "vitest run -c vitest.config.ts",
    "test:deploy": "vitest run -c vitest.config.ts",
    "test:watch": "vitest -c vitest.config.ts",
    "typecheck": "vue-tsc -p tsconfig.build.json --noEmit",
    "types:clean": "rimraf dist/temp-types",
    "lint:lib": "eslint .",
    "gen:globals": "node ./build/generate-global-components.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.2",
    "fs-extra": "^11.3.4",
    "happy-dom": "^20.4.0",
    "postcss": "^8.5.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.57.1",
    "rollup-plugin-dts": "^6.3.0",
    "sass": "^1.97.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "vue": "^3.5.27",
    "vue-tsc": "^2.2.0"
  }
}
