{
  "name": "@vueland/utils-jit",
  "description": "Vite JIT utility engine for Vueland",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "author": {
    "name": "Anar Allakhverdiev",
    "url": "https://github.com/wiseadme"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vueland/vueland.git",
    "directory": "packages/utils-jit"
  },
  "homepage": "https://vueland.github.io/vueland/en/plugins/utils-jit/getting-started",
  "bugs": {
    "url": "https://github.com/vueland/vueland/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "utility-css",
    "classes",
    "jit",
    "utils",
    "utility",
    "scss"
  ],
  "sideEffects": false,
  "scripts": {
    "build-jit": "tsdown",
    "prepack": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "test:deploy": "vitest run -c vitest.config.ts",
    "test:jit": "vitest run -c vitest.config.ts",
    "lint:jit": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "tsdown": "^0.21.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  }
}
