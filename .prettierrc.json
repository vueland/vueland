{
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "proseWrap": "preserve",
    "overrides": [
        {
            "files": ["package.json", "**/package.json"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["*.yaml", "*.yml", "*.scss", "*.css", "*.md"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
