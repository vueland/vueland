{
  "name": "@vueland/eslint-script-setup",
  "description": "ESLint plugin for Vue 3 script setup code style",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "author": {
    "name": "Anar Allakhverdiev",
    "url": "https://github.com/wiseadme"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vueland/vueland.git",
    "directory": "/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "test": "vitest run -c vitest.config.ts",
    "test:watch": "vitest -c vitest.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "vue-eslint-parser": "^10.2.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.0",
    "@types/node": "^25.4.0",
    "@typescript-eslint/parser": "^8.54.0",
    "tsdown": "^0.21.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
